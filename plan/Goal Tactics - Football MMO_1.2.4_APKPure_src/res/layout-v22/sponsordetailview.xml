<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:background="@drawable/background_sponsors"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="90.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_small">
            <TextView
                android:textSize="@dimen/large_text_size"
                android:textColor="@color/colorAccentGreen"
                android:id="@id/sponsor_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Sponsor name"
                style="@style/TextStyle" />
            <TextView
                android:textStyle="italic"
                android:id="@id/sponsor_description"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Sponsor description"
                style="@style/TextStyle" />
            <FrameLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small">
                <TextView
                    android:id="@id/sponsor_date_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/OfferFrom"
                    style="@style/TextStyle" />
                <TextView
                    android:textColor="@color/colorAccentGreen"
                    android:layout_gravity="right"
                    android:id="@id/sponsor_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01.01.2001"
                    style="@style/TextStyle" />
            </FrameLayout>
            <include
                android:id="@id/sponsor_offer_1"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                layout="@layout/sponsoroffer" />
            <include
                android:id="@id/sponsor_offer_2"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                layout="@layout/sponsoroffer" />
            <include
                android:id="@id/sponsor_offer_3"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                layout="@layout/sponsoroffer" />
            <include
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                layout="@layout/sponsoroffercards" />
            <include
                android:id="@id/sponsor_offer_premium"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                layout="@layout/sponsorofferpremium" />
        </LinearLayout>
    </ScrollView>
    <View
        android:background="@drawable/gradient_green_reversed"
        android:layout_width="fill_parent"
        android:layout_height="90.0dip"
        android:layout_alignParentBottom="true" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/sponsor_buttons"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginVertical="@dimen/spacing_medium">
        <crc645877ad3d44b9b81b.GTButton
            android:id="@id/sponsor_button_negotiate"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/button_height"
            android:layout_marginLeft="@dimen/spacing_medium"
            android:layout_marginRight="@dimen/spacing_small"
            android:layout_weight="1.0"
            app:premium="true"
            app:title="@string/Negotiate" />
        <crc645877ad3d44b9b81b.GTButton
            android:id="@id/sponsor_button_accept"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/button_height"
            android:layout_marginLeft="@dimen/spacing_small"
            android:layout_marginRight="@dimen/spacing_medium"
            android:layout_weight="1.0"
            app:premium="false"
            app:title="@string/Accept" />
    </LinearLayout>
    <TextView
        android:textColor="@color/colorAccentGreen"
        android:id="@id/sponsor_manager"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/spacing_small"
        android:layout_marginRight="@dimen/spacing_small"
        android:text="ManagerName"
        android:layout_alignBottom="@id/sponsor_line"
        android:layout_marginHorizontal="@dimen/spacing_small"
        style="@style/SmallTextStyle" />
    <View
        android:id="@id/sponsor_line"
        android:background="@color/colorLadderGreen"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/spacing_minimal"
        android:layout_marginRight="@dimen/spacing_large"
        android:layout_marginBottom="22.0dip"
        android:layout_toRightOf="@id/sponsor_manager"
        android:layout_alignParentBottom="true" />
    <FrameLayout
        android:id="@id/sponsor_sign"
        android:layout_width="200.0dip"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_small"
        android:layout_toRightOf="@id/sponsor_manager"
        android:layout_alignParentBottom="true">
        <ImageView
            android:layout_width="200.0dip"
            android:layout_height="55.0dip"
            android:src="@drawable/signature"
            android:scaleType="fitStart"
            android:contentDescription="" />
    </FrameLayout>
    <ImageView
        android:id="@id/sponsor_stamp"
        android:layout_width="80.0dip"
        android:layout_height="80.0dip"
        android:src="@drawable/stamp_signed"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:contentDescription="" />
</RelativeLayout>