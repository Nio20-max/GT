<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <crc645877ad3d44b9b81b.CustomScrollView
        android:id="@id/StaduimView_ScrollView"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:overScrollMode="never">
        <crc645877ad3d44b9b81b.CustomHorizontalScrollView
            android:id="@id/StaduimView_HorizontalScrollView"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:overScrollMode="never">
            <RelativeLayout
                android:id="@id/StaduimView_MapContainer"
                android:layout_width="1365.0dip"
                android:layout_height="768.0dip">
                <ImageView
                    android:id="@id/StaduimView_Map"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:src="@drawable/map"
                    android:scaleType="centerCrop"
                    android:contentDescription="" />
                <RelativeLayout
                    android:id="@id/StaduimView_MainLayout"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent" />
                <RelativeLayout
                    android:id="@id/StaduimView_Progress"
                    android:layout_width="200.0dip"
                    android:layout_height="200.0dip">
                    <crc645877ad3d44b9b81b.GTProgressBar
                        android:id="@id/StaduimView_ProgressBar"
                        android:layout_width="100.0dip"
                        android:layout_height="20.0dip"
                        android:layout_centerInParent="true" />
                    <TextView
                        android:textColor="@color/colorHighlight"
                        android:gravity="center"
                        android:id="@id/StaduimView_ProgressValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:layout_alignTop="@id/StaduimView_ProgressBar"
                        android:layout_alignBottom="@id/StaduimView_ProgressBar"
                        android:layout_centerHorizontal="true"
                        style="@style/SmallTextStyle" />
                    <TextView
                        android:gravity="center"
                        android:id="@id/StaduimView_ProgressTime"
                        android:background="@drawable/background_darktransparent"
                        android:paddingLeft="@dimen/spacing_medium"
                        android:paddingRight="@dimen/spacing_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_small"
                        android:text="00:00:00"
                        android:layout_above="@id/StaduimView_ProgressBar"
                        android:layout_centerHorizontal="true"
                        android:paddingHorizontal="@dimen/spacing_medium"
                        style="@style/TextStyle" />
                </RelativeLayout>
            </RelativeLayout>
        </crc645877ad3d44b9b81b.CustomHorizontalScrollView>
    </crc645877ad3d44b9b81b.CustomScrollView>
    <LinearLayout
        android:layout_gravity="center|right|top"
        android:orientation="vertical"
        android:id="@id/StaduimView_ProgressWindow"
        android:background="@drawable/background_darktransparent"
        android:padding="@dimen/spacing_medium"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_small">
        <TextView
            android:layout_gravity="center_horizontal"
            android:id="@id/StaduimView_ProgressWindowName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Building name"
            android:layout_alignLeft="@id/StaduimView_ProgressBar"
            android:layout_alignTop="@id/StaduimView_ProgressBar"
            android:layout_alignRight="@id/StaduimView_ProgressBar"
            android:layout_alignBottom="@id/StaduimView_ProgressBar"
            style="@style/TextStyle" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/BuildProgress"
                style="@style/SmallTextStyle" />
            <TextView
                android:textColor="@color/colorAccentGreen"
                android:gravity="center"
                android:id="@id/StaduimView_ProgressWindowProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacing_small"
                android:text="0%"
                style="@style/SmallTextStyle" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/CompleteIn"
                style="@style/SmallTextStyle" />
            <TextView
                android:textColor="@color/colorAccentGreen"
                android:gravity="center"
                android:id="@id/StaduimView_ProgressWindowTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacing_small"
                android:text="00:00:00"
                style="@style/SmallTextStyle" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>