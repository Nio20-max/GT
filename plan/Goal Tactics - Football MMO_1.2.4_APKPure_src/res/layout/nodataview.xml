        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.65"
        style="@style/LargeTextStyle" />
    <crc645877ad3d44b9b81b.GTButton
        android:id="@id/noData_Button1"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/spacing_extralarge"
        android:layout_marginRight="@dimen/spacing_large"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/noData_Description"
        app:layout_constraintWidth_percent="0.33"
        app:premium="false" />
    <crc645877ad3d44b9b81b.GTButton
        android:id="@id/noData_Button2"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/spacing_large"
        android:layout_marginRight="@dimen/spacing_large"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/noData_Button1"
        app:layout_constraintWidth_percent="0.33"
        app:premium="false" />
</androidx.constraintlayout.widget.ConstraintLayout>