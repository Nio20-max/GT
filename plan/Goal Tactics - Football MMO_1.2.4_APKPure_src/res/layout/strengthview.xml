<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <crc645877ad3d44b9b81b.GTStrengthStarsView
        android:id="@id/strengthStars"
        android:layout_width="wrap_content"
        android:layout_height="18.0dip"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true" />
    <TextView
        android:id="@id/strengthText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/spacing_small"
        android:layout_toLeftOf="@id/strengthStars"
        android:layout_centerVertical="true"
        style="@style/TextStyle" />
    <TextView
        android:textColor="@color/colorAccentGreen"
        android:id="@id/strengthRange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1.0dip"
        android:layout_below="@id/strengthStars"
        android:layout_alignRight="@id/strengthStars"
        style="@style/SmallTextStyle" />
</RelativeLayout>