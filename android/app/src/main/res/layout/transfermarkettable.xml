<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ListView
        android:id="@id/transfermarket_ResultsTable"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <TextView
        android:id="@id/transfermarket_NoResultsContainer"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        app:button_1_text="@string/QuickSearch"
        app:button_2_text="@string/Reset"
        app:character="ScoutPoint"
        app:message="@string/NoResultsDescription" />
</FrameLayout>