<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@id/bidView_auctionTimeText"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_small"
                android:text="@string/EndAuction"
                style="@style/TextStyle" />
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@id/bidView_auctionTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    android:src="@drawable/clock" />
                <TextView
                    android:textColor="@color/colorAccentGreen"
                    android:layout_gravity="center_vertical"
                    android:id="@id/DetailedPlayerInfo_EndOfAuction"
                    android:paddingLeft="@dimen/spacing_small"
                    android:paddingRight="@dimen/spacing_small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_minimal"
                    android:text="99:99:99"
                    style="@style/LargeTextStyle" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:layout_gravity="center_horizontal"
                android:id="@id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Seller"
                style="@style/TextStyle" />
            <TextView
                android:textColor="@color/colorAccentGreen"
                android:layout_gravity="center_horizontal"
                android:id="@id/DetailedPlayerInfo_Seller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seller Team"
                style="@style/TextStyle" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@id/bidView_bidFrame"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/DetailedPlayerInfo_BidTeamLogo"
                android:layout_width="45.0dip"
                android:layout_height="45.0dip"
                android:layout_marginRight="@dimen/spacing_medium"
                android:src="@drawable/wappen01_normal" />
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:id="@id/DetailedPlayerInfo_BidGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_gravity="center_horizontal"
                    android:id="@id/DetailedPlayerInfo_BidTeamName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bid Team"
                    style="@style/TextStyle" />
                <TextView
                    android:textColor="@color/colorEuro"
                    android:layout_gravity="center_horizontal"
                    android:id="@id/DetailedPlayerInfo_Bid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    style="@style/LargeTextStyle" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@id/bidView_buttonFrame"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/colorAccentGreen"
                android:layout_gravity="center_horizontal"
                android:id="@id/DetailedPlayerInfo_BidUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_small"
                android:text="0"
                style="@style/TextStyle" />
            <Button
                android:layout_gravity="center_horizontal"
                android:id="@id/DetailedPlayerInfo_BidButton"
                android:tag="bid_button"
                android:layout_width="@dimen/button_width"
                android:layout_height="@dimen/button_height"
                app:premium="true"
                app:title="@string/Bid" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>