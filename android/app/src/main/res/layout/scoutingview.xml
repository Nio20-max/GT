<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/background_transparent"
    android:padding="@dimen/spacing_small"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_marginTop="@dimen/spacing_small"
    android:layout_marginBottom="@dimen/spacing_small"
    android:layout_marginStart="@dimen/scouting_margin_start"
    android:layout_marginEnd="@dimen/spacing_small"
    android:layout_alignParentEnd="true"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:id="@id/scoutingTitle"
        android:paddingLeft="@dimen/spacing_medium"
        android:paddingRight="@dimen/spacing_medium"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="@string/InstructTitle"
        android:maxLines="2"
        style="@style/TextStyle" />
    <RelativeLayout
        android:orientation="horizontal"
        android:background="@drawable/background_darkgreen"
        android:padding="@dimen/spacing_small"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginLeft="@dimen/spacing_small"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginRight="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_small"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@id/scoutingSeparator"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:src="@drawable/separator"
            android:scaleType="centerCrop"
            android:layout_centerInParent="true"
            android:contentDescription="" />
        <TextView
            android:gravity="center"
            android:id="@id/instructScout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/InstructScout"
            android:maxLines="1"
            android:layout_alignEnd="@id/scoutingSeparator"
            android:layout_alignParentStart="true"
            style="@style/TextStyle" />
        <Button
            android:gravity="center"
            android:id="@id/instructButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/teamview_greenbutton_height"
            android:layout_marginLeft="@dimen/spacing_large"
            android:layout_marginRight="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:layout_alignParentBottom="true"
            android:layout_alignEnd="@id/scoutingSeparator"
            android:layout_alignParentStart="true"
            style="@style/ButtonStyle" />
        <ImageView
            android:id="@id/instructNormalImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/spacing_small"
            android:layout_marginRight="@dimen/spacing_small"
            android:src="@drawable/characters_player_normalscout"
            android:layout_above="@id/instructButton"
            android:layout_below="@id/instructScout"
            android:contentDescription=""
            android:layout_alignEnd="@id/scoutingSeparator"
            android:layout_alignParentStart="true" />
        <TextView
            android:gravity="center"
            android:id="@id/instructSpecial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/InstructSpecial"
            android:maxLines="1"
            android:layout_alignStart="@id/scoutingSeparator"
            android:layout_alignParentEnd="true"
            style="@style/TextStyle" />
        <Spinner
            android:id="@id/scoutingSelectPosition"
            android:layout_width="wrap_content"
            android:layout_height="150.0dip"
            android:layout_marginLeft="@dimen/spacing_large"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginRight="@dimen/spacing_large"
            android:text="@string/SelectPosition"
            android:layout_below="@id/instructSpecial"
            android:layout_alignStart="@id/scoutingSeparator"
            android:layout_alignParentEnd="true"
            android:translationZ="100.0dip" />
        <Button
            android:gravity="center"
            android:id="@id/instructSpeedUpButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/teamview_greenbutton_height"
            android:layout_marginLeft="@dimen/spacing_large"
            android:layout_marginRight="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:layout_alignParentBottom="true"
            android:layout_alignStart="@id/scoutingSeparator"
            android:layout_alignParentEnd="true"
            style="@style/PremiumButtonStyle" />
        <Button
            android:gravity="center"
            android:id="@id/instructSpecialButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/teamview_greenbutton_height"
            android:layout_marginLeft="@dimen/spacing_large"
            android:layout_marginRight="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:layout_alignParentBottom="true"
            android:layout_alignStart="@id/scoutingSeparator"
            android:layout_alignParentEnd="true"
            style="@style/PremiumButtonStyle" />
        <ImageView
            android:id="@id/instructSpecialImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/spacing_small"
            android:layout_marginRight="@dimen/spacing_small"
            android:src="@drawable/characters_player_specialscout"
            android:layout_above="@id/instructButton"
            android:layout_below="@id/instructSpecial"
            android:contentDescription=""
            android:layout_alignStart="@id/scoutingSeparator"
            android:layout_alignParentEnd="true" />
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/instructButton"
            android:layout_below="@id/instructSpecial"
            android:layout_alignStart="@id/scoutingSeparator"
            android:layout_alignParentEnd="true">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@id/instructSpecialTimer"
                android:background="@drawable/background_darktransparent"
                android:padding="@dimen/spacing_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/TimeLeftValue"
                    style="@style/TextStyle" />
                <TextView
                    android:layout_gravity="center"
                    android:id="@id/timerSpecialCooldown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextStyle" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/instructButton"
            android:layout_below="@id/instructScout"
            android:layout_alignEnd="@id/scoutingSeparator"
            android:layout_alignParentStart="true">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@id/instructTimer"
                android:background="@drawable/background_darktransparent"
                android:padding="@dimen/spacing_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/TimeLeftValue"
                    style="@style/TextStyle" />
                <TextView
                    android:layout_gravity="center"
                    android:id="@id/timerInstructCooldown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextStyle" />
            </LinearLayout>
        </FrameLayout>
    </RelativeLayout>
</LinearLayout>