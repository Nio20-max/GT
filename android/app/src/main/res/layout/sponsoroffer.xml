<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@drawable/background_sponsorscell"
    android:padding="@dimen/spacing_small"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:id="@id/sponsor_offer_title"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/sponsor_offer_value"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle" />
    <TextView
        android:textColor="@color/colorEuro"
        android:id="@id/sponsor_offer_value"
        android:paddingLeft="@dimen/spacing_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@id/sponsor_offer_previous"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle" />
    <TextView
        android:textColor="@color/color_chart_income"
        android:id="@id/sponsor_offer_previous"
        android:paddingLeft="@dimen/spacing_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SmallTextStyle" />
</androidx.constraintlayout.widget.ConstraintLayout>