<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@id/compareNameFrame"
        android:layout_width="fill_parent"
        android:layout_height="60.0dip" />
    <TextView
        android:id="@id/compareClubName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="@id/compareNameFrame"
        app:layout_constraintEnd_toEndOf="@id/compareNameFrame"
        app:layout_constraintHorizontal_weight="3.0"
        app:layout_constraintStart_toStartOf="@id/compareNameFrame"
        app:layout_constraintTop_toTopOf="@id/compareNameFrame"
        style="@style/LargeTextStyle" />
    <ImageView
        android:id="@id/compareClubEmblem"
        android:padding="@dimen/spacing_small"
        android:layout_width="0.0dip"
        android:layout_height="50.0dip"
        android:src="@drawable/wappen01_normal"
        android:scaleType="fitEnd"
        app:layout_constraintBottom_toBottomOf="@id/compareNameFrame"
        app:layout_constraintEnd_toStartOf="@id/compareClubName"
        app:layout_constraintHorizontal_weight="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/compareNameFrame" />
    <Button
        android:id="@id/compareClubButtonFriends"
        android:layout_width="@dimen/button_width"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/spacing_medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/compareNameFrame" />
    <Button
        android:id="@id/compareClubButtonMatch"
        android:layout_width="@dimen/button_width"
        android:layout_height="@dimen/button_height"
        android:layout_marginEnd="@dimen/spacing_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/compareNameFrame"
        app:title="@string/FriendlyMatch" />
    <ImageView
        android:id="@id/compareClubShirtHome"
        android:layout_width="30.0dip"
        android:layout_height="30.0dip"
        android:src="@drawable/trikot0"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/compareClubButtonFriends"
        app:layout_constraintEnd_toStartOf="@id/compareClubShirtAway"
        app:layout_constraintStart_toEndOf="@id/compareClubButtonFriends"
        app:layout_constraintTop_toBottomOf="@id/compareNameFrame" />
    <ImageView
        android:id="@id/compareClubShirtAway"
        android:layout_width="30.0dip"
        android:layout_height="30.0dip"
        android:src="@drawable/trikot1"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/compareClubButtonMatch"
        app:layout_constraintEnd_toStartOf="@id/compareClubButtonMatch"
        app:layout_constraintStart_toEndOf="@id/compareClubShirtHome"
        app:layout_constraintTop_toBottomOf="@id/compareNameFrame" />
    <ListView
        android:id="@id/compareClubInfo"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_marginTop="15.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/compareClubButtonMatch" />
</androidx.constraintlayout.widget.ConstraintLayout>