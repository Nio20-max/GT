<?xml version="1.0" encoding="utf-8"?>
<!-- Scouting layout matching APK scoutingview.xml: split normal/special scout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical"
    android:padding="@dimen/spacing_small">

    <!-- Title -->
    <TextView
        android:id="@+id/scoutingTitle"
        style="@style/TextStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:text="@string/instruct_title" />

    <!-- Main scouting area with separator -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/spacing_small"
        android:layout_marginVertical="@dimen/spacing_small"
        android:background="@drawable/background_darkgreen"
        android:padding="@dimen/spacing_small">

        <!-- Center separator -->
        <View
            android:id="@+id/scoutingSeparator"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:layout_marginVertical="@dimen/spacing_medium"
            android:background="@color/colorGray" />

        <!-- LEFT: Normal scout (money) -->
        <TextView
            android:id="@+id/instructScout"
            style="@style/TextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignEnd="@id/scoutingSeparator"
            android:layout_alignParentStart="true"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/instruct_scout" />

        <ImageView
            android:id="@+id/instructNormalImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/instructButton"
            android:layout_alignEnd="@id/scoutingSeparator"
            android:layout_alignParentStart="true"
            android:layout_below="@id/instructScout"
            android:layout_marginHorizontal="@dimen/spacing_small"
            android:contentDescription=""
            android:scaleType="fitCenter" />

        <Button
            android:id="@+id/instructButton"
            style="@style/ButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/teamview_greenbutton_height"
            android:layout_alignEnd="@id/scoutingSeparator"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_marginHorizontal="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:gravity="center"
            android:text="@string/scout_money" />

        <!-- Timer overlay for normal scout -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/instructButton"
            android:layout_alignEnd="@id/scoutingSeparator"
            android:layout_alignParentStart="true"
            android:layout_below="@id/instructScout">

            <LinearLayout
                android:id="@+id/instructTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/background_darktransparent"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium"
                android:visibility="gone">

                <TextView
                    style="@style/TextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/time_left" />

                <TextView
                    android:id="@+id/timerInstructCooldown"
                    style="@style/TextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </LinearLayout>
        </FrameLayout>

        <!-- RIGHT: Special scout (stars) -->
        <TextView
            android:id="@+id/instructSpecial"
            style="@style/TextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignStart="@id/scoutingSeparator"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/instruct_special" />

        <Spinner
            android:id="@+id/scoutingSelectPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignStart="@id/scoutingSeparator"
            android:layout_below="@id/instructSpecial"
            android:layout_marginHorizontal="@dimen/spacing_large"
            android:layout_marginTop="@dimen/spacing_medium"
            android:background="@drawable/background_combobox" />

        <Button
            android:id="@+id/instructSpecialButton"
            style="@style/ButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/teamview_greenbutton_height"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_alignStart="@id/scoutingSeparator"
            android:layout_marginHorizontal="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:gravity="center"
            android:text="@string/scout_stars" />

        <Button
            android:id="@+id/instructSpeedUpButton"
            style="@style/ButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/teamview_greenbutton_height"
            android:layout_above="@id/instructSpecialButton"
            android:layout_alignParentEnd="true"
            android:layout_alignStart="@id/scoutingSeparator"
            android:layout_marginHorizontal="@dimen/spacing_large"
            android:gravity="center"
            android:text="@string/speedup"
            android:visibility="gone" />

        <!-- Timer overlay for special scout -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/instructSpecialButton"
            android:layout_alignParentEnd="true"
            android:layout_alignStart="@id/scoutingSeparator"
            android:layout_below="@id/instructSpecial">

            <LinearLayout
                android:id="@+id/instructSpecialTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/background_darktransparent"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium"
                android:visibility="gone">

                <TextView
                    style="@style/TextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/time_left" />

                <TextView
                    android:id="@+id/timerSpecialCooldown"
                    style="@style/TextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </LinearLayout>
        </FrameLayout>

    </RelativeLayout>
</LinearLayout>
