<?xml version="1.0" encoding="utf-8"?>
<GridLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:rowCount="7"
    android:columnCount="3"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:gravity="bottom|center|right"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="0"
        android:layout_row="0"
        android:layout_rowWeight="3.0"
        android:layout_columnWeight="3.0">
        <TextView
            android:textColor="@color/colorAccentGreen"
            android:id="@id/homeName"
            android:padding="15.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home team Name"
            android:maxLines="1"
            style="@style/TextStyle" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="bottom|center|left"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="2"
        android:layout_row="0"
        android:layout_rowWeight="3.0"
        android:layout_columnWeight="3.0">
        <TextView
            android:textColor="@color/colorAccentGreen"
            android:id="@id/awayName"
            android:padding="15.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Away team Name"
            android:maxLines="1"
            style="@style/TextStyle" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center|right"
        android:padding="5.0dip"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="0"
        android:layout_row="1"
        android:layout_rowWeight="1.0"
        android:layout_columnWeight="1.0">
        <ProgressBarBar
            android:id="@id/homePossession"
            android:layout_width="80.0dip"
            android:layout_height="25.0dip" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="1"
        android:layout_row="1"
        android:layout_rowWeight="1.0"
        android:layout_columnWeight="1.0">
        <TextView
            android:textColor="@android:color/white"
            android:id="@id/possessionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Possession"
            android:maxLines="1"
            style="@style/TextStyle" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center|left"
        android:padding="5.0dip"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="2"
        android:layout_row="1"
        android:layout_rowWeight="1.0"
        android:layout_columnWeight="1.0">
        <ProgressBarBar
            android:id="@id/awayPossession"
            android:layout_width="80.0dip"
            android:layout_height="25.0dip" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center|right"
        android:padding="5.0dip"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="0"
        android:layout_row="2"
        android:layout_rowWeight="1.0"
        android:layout_columnWeight="1.0">
        <ProgressBarBar
            android:id="@id/homeShotsOnTarget"
            android:layout_width="80.0dip"
            android:layout_height="25.0dip" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="1"
        android:layout_row="2"
        android:layout_rowWeight="1.0"
        android:layout_columnWeight="1.0">
        <TextView
            android:textColor="@android:color/white"
            android:id="@id/shotsOnTargetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shots on target"
            android:maxLines="1"
            style="@style/TextStyle" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center|left"
        android:padding="5.0dip"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="2"
        android:layout_row="2"
        android:layout_rowWeight="1.0"
        android:layout_columnWeight="1.0">
        <ProgressBarBar
            android:id="@id/awayShotsOnTarget"
            android:layout_width="80.0dip"
            android:layout_height="25.0dip" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center|right"
        android:padding="5.0dip"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="0"
        android:layout_row="3"
        android:layout_rowWeight="1.0"
        android:layout_columnWeight="1.0">
        <ProgressBarBar
            android:id="@id/homeYellowCards"
            android:layout_width="80.0dip"
            android:layout_height="25.0dip" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="1"
        android:layout_row="3"
        android:layout_rowWeight="1.0"
        android:layout_columnWeight="1.0">
        <TextView
            android:textColor="@android:color/white"
            android:id="@id/yellowCardsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yellow cards"
            android:maxLines="1"
            style="@style/TextStyle" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center|left"
        android:padding="5.0dip"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="2"
        android:layout_row="3"
        android:layout_rowWeight="1.0"
        android:layout_columnWeight="1.0">
        <ProgressBarBar
            android:id="@id/awayYellowCards"
            android:layout_width="80.0dip"
            android:layout_height="25.0dip" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center|right"
        android:padding="5.0dip"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="0"
        android:layout_row="4"
        android:layout_rowWeight="1.0"
        android:layout_columnWeight="1.0">
        <ProgressBarBar
            android:id="@id/homeRedCards"
            android:layout_width="80.0dip"
            android:layout_height="25.0dip" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="1"
        android:layout_row="4"
        android:layout_rowWeight="1.0"
        android:layout_columnWeight="1.0">
        <TextView
            android:textColor="@android:color/white"
            android:id="@id/redCardsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Red cards"
            android:maxLines="1"
            style="@style/TextStyle" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center|left"
        android:padding="5.0dip"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="2"
        android:layout_row="4"
        android:layout_rowWeight="1.0"
        android:layout_columnWeight="1.0">
        <ProgressBarBar
            android:id="@id/awayRedCards"
            android:layout_width="80.0dip"
            android:layout_height="25.0dip" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center|right"
        android:padding="5.0dip"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="0"
        android:layout_row="5"
        android:layout_rowWeight="1.0"
        android:layout_columnWeight="1.0">
        <ProgressBarBar
            android:id="@id/homeCorners"
            android:layout_width="80.0dip"
            android:layout_height="25.0dip" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="1"
        android:layout_row="5"
        android:layout_rowWeight="1.0"
        android:layout_columnWeight="1.0">
        <TextView
            android:textColor="@android:color/white"
            android:id="@id/cornersText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Corners"
            android:maxLines="1"
            style="@style/TextStyle" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center|left"
        android:padding="5.0dip"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="2"
        android:layout_row="5"
        android:layout_rowWeight="1.0"
        android:layout_columnWeight="1.0">
        <ProgressBarBar
            android:id="@id/awayCorners"
            android:layout_width="80.0dip"
            android:layout_height="25.0dip" />
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_column="0"
        android:layout_row="6"
        android:layout_rowWeight="3.0"
        android:layout_columnWeight="3.0" />
</GridLayout>