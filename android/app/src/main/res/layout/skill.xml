<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@id/skill_frame"
        android:background="@drawable/skill_card_0"
        android:layout_width="0.0dip"
        android:layout_height="fill_parent"
        android:layout_margin="@dimen/spacing_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="10:14"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.cardview.widget.CardView
        android:id="@id/skillImageContainer"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_margin="@dimen/card_border_margin"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="0.0dip"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintLeft_toLeftOf="@id/skill_frame"
        app:layout_constraintRight_toRightOf="@id/skill_frame"
        app:layout_constraintTop_toTopOf="@id/skill_frame">
        <ImageView
            android:id="@id/skillImage"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:contentDescription=""
            app:touchable="true" />
    </androidx.cardview.widget.CardView>
    <TextView
        android:gravity="center"
        android:id="@id/skillName"
        android:padding="@dimen/spacing_small"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginLeft="@dimen/card_border_margin"
        android:layout_marginRight="@dimen/card_border_margin"
        android:layout_marginBottom="@dimen/card_border_margin"
        android:text="Through the middle"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="@id/skill_frame"
        app:layout_constraintLeft_toLeftOf="@id/skill_frame"
        app:layout_constraintRight_toRightOf="@id/skill_frame"
        app:layout_constraintTop_toBottomOf="@id/skillImageContainer"
        style="@style/AutoSizeTextStyle" />
</androidx.constraintlayout.widget.ConstraintLayout>