<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main application theme (matches original APK GTTheme) -->
    <style name="GTTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColorHint">@color/colorGray</item>
        <item name="colorAccent">@color/colorAccentGreen</item>
        <item name="colorPrimary">@color/colorText</item>
        <item name="colorPrimaryDark">@color/colorGray</item>
    </style>

</resources>
