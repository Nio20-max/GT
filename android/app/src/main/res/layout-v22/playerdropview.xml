<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <de.gt.app.views.PlayerRoundAvatar
        android:id="@id/PlayerDrop_RoundAvatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5.0dip"
        android:layout_marginRight="5.0dip"
        android:layout_marginBottom="5.0dip"
        android:scaleX="0.85"
        android:scaleY="0.85"
        android:layout_marginHorizontal="5.0dip" />
    <TextView
        android:textColor="@color/colorHighlight"
        android:layout_gravity="start"
        android:id="@id/PlayerDrop_Strength"
        android:background="@drawable/background_transparent"
        android:paddingLeft="3.0dip"
        android:paddingRight="3.0dip"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.0"
        android:paddingHorizontal="3.0dip"
        style="@style/SmallTextStyle" />
    <TextView
        android:gravity="center"
        android:layout_gravity="bottom|center"
        android:id="@id/PlayerDrop_Position"
        android:background="@drawable/background_transparent"
        android:paddingLeft="5.0dip"
        android:paddingRight="5.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Position"
        android:maxLines="1"
        android:maxLength="12"
        android:paddingHorizontal="5.0dip"
        style="@style/SmallTextStyle" />
</FrameLayout>