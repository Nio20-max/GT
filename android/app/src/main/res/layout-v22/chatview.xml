<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/background_chat"
    android:paddingLeft="50.0dip"
    android:paddingRight="50.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:paddingHorizontal="50.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ListView
        android:id="@id/chatView_MessagesList"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="5.0" />
    <TextView
        android:textColor="@color/colorDarkGray"
        android:id="@id/chatView_Typing"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        style="@style/SmallTextStyle" />
    <LinearLayout
        android:orientation="horizontal"
        android:paddingBottom="@dimen/spacing_small"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textColorHint="@color/colorGray"
            android:id="@id/chatView_MessageText"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/entry_height"
            android:layout_marginRight="@dimen/spacing_small"
            android:hint="@string/YourMessageHere"
            android:width="@dimen/entry_width"
            android:layout_weight="8.0"
            android:inputType="text"
            android:imeOptions="actionGo|flagNoExtractUi"
            style="@style/EntryStyle" />
        <ImageView
            android:layout_gravity="center"
            android:id="@id/chatView_SendMessageButton"
            android:layout_width="25.0dip"
            android:layout_height="25.0dip"
            android:src="@drawable/arrow_up_selector"
            android:scaleType="fitXY"
            android:contentDescription="" />
    </LinearLayout>
</LinearLayout>